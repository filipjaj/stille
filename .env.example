# Signerer sesjoner. Lag en med: openssl rand -hex 32
PAYLOAD_SECRET=

# Administratoren seed oppretter. Passordet genereres og skrives ut en gang
# hvis det star tomt.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Butikkens egen adresse. Gjor lenker og bildeadresser i e-postene absolutte.
# En e-post har ingen base-URL, sa uten denne blir bildene i ordrebekreftelsen
# brutt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Betaling. Uten disse fungerer butikken, men ikke kassen.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOKS_SIGNING_SECRET=

# E-post. Uten disse gar ordrebekreftelsen ikke ut - kjopet star likevel.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
